<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/setting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Hello World!"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvInfoNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Hello World!"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvInfoBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Hello World!"
            android:textSize="20sp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="无障碍服务-Click Skip" />

        <Button
            android:id="@+id/testAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试无障碍服务" />
    </LinearLayout>

    <Button
        android:id="@+id/btnNotification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:text="检查通知权限"
        app:layout_constraintEnd_toStartOf="@+id/btnBattery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting" />

    <Button
        android:id="@+id/btnBattery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="检查电池优化"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnNotification"
        app:layout_constraintTop_toTopOf="@+id/btnNotification" />

</androidx.constraintlayout.widget.ConstraintLayout>